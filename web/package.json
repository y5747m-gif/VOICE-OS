{
  "name": "voice-os-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-pwa.mjs",
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "test": "node --test",
    "release:android": "node --env-file-if-exists=.env.local scripts/publish-android.mjs",
    "test:pwa": "node scripts/check-pwa.mjs"
  },
  "dependencies": {
    "@fontsource-variable/alexandria": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "lucide-react": "0.545.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "playwright": "1.65.1",
    "vite": "6.4.6"
  }
}

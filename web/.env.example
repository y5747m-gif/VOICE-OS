# Copy this file to .env.local. These keys are server-only; never use a VITE_ prefix
# and never commit the copied file.
GROQ_API_KEY=
# Optional model overrides for Groq speech transcription and safe site-command classification.
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_COMMAND_MODEL=llama-3.3-70b-versatile

# Optional spoken replies from ElevenLabs. The browser's local speech voice works without this.
ELEVENLABS_API_KEY=

# Optional native APK download. Publish with npm run release:android (see web/README.md).
# The signer fingerprint is public; it pins which signing certificate your server accepts.
ANDROID_RELEASE_DIR=
ANDROID_SIGNER_SHA256=

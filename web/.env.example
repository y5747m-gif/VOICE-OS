# Copy this file to .env.local and set a server-only ElevenLabs API key.
# Do NOT prefix the key with VITE_ or commit the copied file.
ELEVENLABS_API_KEY=

# Optional native APK download. Publish with npm run release:android (see web/README.md).
# The signer fingerprint is public; it pins which signing certificate your server accepts.
ANDROID_RELEASE_DIR=
ANDROID_SIGNER_SHA256=
